@model NCRManagementSystem.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "เข้าสู่ระบบ - NCR Management System";
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <link href="~/css/ncr-custom.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .login-container {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            padding: 0;
            overflow: hidden;
            width: 100%;
            max-width: 1300px;
            min-height: 500px;
        }

        .login-left {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 60px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .login-right {
            padding: 60px 50px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .brand-logo {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .brand-title {
            font-size: 2rem;
            font-weight: bold;
            margin-bottom: 0.5rem;
        }

        .role-selector {
            display: flex;
            gap: 10px;
            margin-bottom: 1.5rem;
        }

        .role-option {
            flex: 1;
            text-align: center;
            padding: 10px;
            border: 2px solid #e9ecef;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            background: #f8f9fa;
            color: #333;
        }

        .role-option:hover {
            border-color: #667eea;
            background: #f8f9ff;
        }

        .role-option.active {
            border-color: #667eea;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-login {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 10px;
            padding: 12px;
            font-size: 1.1rem;
            font-weight: 600;
            color: white;
            transition: all 0.3s ease;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
            color: white;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="login-container row g-0">
                    <!-- Left Side - Branding -->
                    <div class="col-lg-6 login-left">
                        <div class="text-center">
                            <i class="fas fa-clipboard-check brand-logo"></i>
                            <h1 class="brand-title">NCR System</h1>
                            <p class="brand-subtitle">ระบบจัดการ Non-Conformance Report</p>

                            <ul class="list-unstyled mt-4">
                                <li class="mb-3"><i class="fas fa-check me-2"></i>จัดการปัญหาคุณภาพอย่างเป็นระบบ</li>
                                <li class="mb-3"><i class="fas fa-check me-2"></i>ติดตามการแก้ไขแบบ Real-time</li>
                                <li class="mb-3"><i class="fas fa-check me-2"></i>รายงานและวิเคราะห์สถิติ</li>
                                <li class="mb-3"><i class="fas fa-check me-2"></i>ระบบแจ้งเตือนอัตโนมัติ</li>
                            </ul>

                            <div class="mt-4 p-3 bg-white bg-opacity-10 rounded">
                                <small><i class="fas fa-shield-alt me-2"></i>Secure & Reliable</small>
                                <div class="mt-1"><small>Version 2.0.1 | Build 2025.08</small></div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Side - Login Form -->
                    <div class="col-lg-6 login-right">
                        <div class="login-form">
                            <h2 class="text-center mb-1">เข้าสู่ระบบ</h2>
                            <p class="text-center text-muted mb-4">กรุณาเข้าสู่ระบบเพื่อดำเนินการต่อ</p>

                            <!-- Role Selection -->
                            <div class="role-selector">
                                <div class="role-option active" data-role="User">
                                    <i class="fas fa-user d-block mb-1"></i>
                                    <div>ผู้ใช้งาน</div>
                                </div>
                                <div class="role-option" data-role="QA">
                                    <i class="fas fa-search d-block mb-1"></i>
                                    <div>QA</div>
                                </div>
                                <div class="role-option" data-role="Manager">
                                    <i class="fas fa-user-tie d-block mb-1"></i>
                                    <div>Manager</div>
                                </div>
                                <div class="role-option" data-role="Admin">
                                    <i class="fas fa-cog d-block mb-1"></i>
                                    <div>Admin</div>
                                </div>
                            </div>

                            <form id="loginForm" asp-action="Login" asp-controller="Auth" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="ReturnUrl" />

                                <!-- Username -->
                                <div class="input-group mb-3">
                                    <span class="input-group-text">
                                        <i class="fas fa-user"></i>
                                    </span>
                                    <input asp-for="Username" class="form-control" placeholder="ชื่อผู้ใช้หรืออีเมล" required>
                                </div>
                                <span asp-validation-for="Username" class="text-danger"></span>

                                <!-- Password -->
                                <div class="input-group mb-3">
                                    <span class="input-group-text">
                                        <i class="fas fa-lock"></i>
                                    </span>
                                    <input asp-for="Password" type="password" class="form-control" placeholder="รหัสผ่าน" required>
                                    <span class="password-toggle" onclick="togglePassword()">
                                        <i class="fas fa-eye" id="passwordIcon"></i>
                                    </span>
                                </div>
                                <span asp-validation-for="Password" class="text-danger"></span>

                                <!-- Hidden Role Field -->
                                <input asp-for="Role" type="hidden" value="User" />
                                <span asp-validation-for="Role" class="text-danger"></span>

                                <!-- Remember Me -->
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="form-check">
                                        <input asp-for="RememberMe" class="form-check-input" type="checkbox">
                                        <label asp-for="RememberMe" class="form-check-label">
                                            จำรหัสผ่าน
                                        </label>
                                    </div>
                                </div>

                                <!-- Login Button -->
                                <button type="submit" class="btn btn-login w-100 mb-3">
                                    <span class="loading-spinner spinner-border spinner-border-sm d-none me-2" role="status"></span>
                                    <span class="btn-text">เข้าสู่ระบบ</span>
                                </button>

                                <!-- Demo Accounts -->
                                <div class="text-center">
                                    <p class="text-muted small mb-2">บัญชีทดสอบระบบ:</p>
                                    <div class="d-flex gap-2 flex-wrap justify-content-center">
                                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="setDemoLogin('User')">
                                            <i class="fas fa-user me-1"></i>User Demo
                                        </button>
                                        <button type="button" class="btn btn-outline-info btn-sm" onclick="setDemoLogin('QA')">
                                            <i class="fas fa-search me-1"></i>QA Demo
                                        </button>
                                        <button type="button" class="btn btn-outline-success btn-sm" onclick="setDemoLogin('Manager')">
                                            <i class="fas fa-user-tie me-1"></i>Manager Demo
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm" onclick="setDemoLogin('Admin')">
                                            <i class="fas fa-cog me-1"></i>Admin Demo
                                        </button>
                                    </div>
                                </div>
                            </form>

                            <!-- Footer Info -->
                            <div class="text-center mt-4 pt-3 border-top">
                                <small class="text-muted">
                                    <i class="fas fa-shield-alt me-1"></i>
                                    ระบบปลอดภัยด้วย SSL Encryption
                                </small>
                                <div class="mt-2">
                                    <small class="text-muted">
                                        © 2025 NCR Management System. All rights reserved.
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function() {
            // Role Selection
            $('.role-option').click(function() {
                $('.role-option').removeClass('active');
                $(this).addClass('active');

                const role = $(this).data('role');
                $('input[name="Role"]').val(role);

                console.log('Selected role:', role); // Debug log

                // Update placeholder based on role
                const placeholders = {
                    'User': 'ชื่อผู้ใช้หรืออีเมล',
                    'QA': 'รหัสพนักงาน QA',
                    'Manager': 'รหัสผู้จัดการ',
                    'Admin': 'รหัส Administrator'
                };
                $('input[name="Username"]').attr('placeholder', placeholders[role] || 'ชื่อผู้ใช้หรืออีเมล');
            });

            // Form Submission
            $('#loginForm').submit(function(e) {
                e.preventDefault();

                const formData = {
                    Username: $('input[name="Username"]').val(),
                    Password: $('input[name="Password"]').val(),
                    Role: $('input[name="Role"]').val(),
                    RememberMe: $('input[name="RememberMe"]').is(':checked'),
                    ReturnUrl: $('input[name="ReturnUrl"]').val(),
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                };

                const $submitBtn = $(this).find('button[type="submit"]');
                const $spinner = $submitBtn.find('.loading-spinner');
                const $btnText = $submitBtn.find('.btn-text');

                // Show loading
                $submitBtn.prop('disabled', true);
                $spinner.removeClass('d-none');
                $btnText.text('กำลังเข้าสู่ระบบ...');

                $.ajax({
                    url: '/Auth/Login',
                    type: 'POST',
                    data: formData,
                    success: function(response) {

                        console.log('Login response:', response); // Debug log

                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'เข้าสู่ระบบสำเร็จ!',
                                text: 'กำลังเปลี่ยนเส้นทาง...',
                                timer: 2000,
                                showConfirmButton: false
                            }).then(() => {
                                window.location.href = response.redirectUrl;
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'เข้าสู่ระบบไม่สำเร็จ',
                                text: response.message
                            });
                        }
                    },
                    error: function() {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้'
                        });
                    },
                    complete: function() {
                        // Hide loading
                        $submitBtn.prop('disabled', false);
                        $spinner.addClass('d-none');
                        $btnText.text('เข้าสู่ระบบ');
                    }
                });
            });
        });

        // Password Toggle
        function togglePassword() {
            const passwordInput = document.querySelector('input[name="Password"]');
            const passwordIcon = document.getElementById('passwordIcon');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                passwordIcon.classList.remove('fa-eye');
                passwordIcon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                passwordIcon.classList.remove('fa-eye-slash');
                passwordIcon.classList.add('fa-eye');
            }
        }

        // Demo Login Function
        function setDemoLogin(role) {
            const usernames = {
                'User': 'demo.user',
                'QA': 'demo.qa',
                'Manager': 'demo.manager',
                'Admin': 'demo.admin'
            };

            // Set role
            $('input[name="Role"]').val(role);

            // Update UI
            $('.role-option').removeClass('active');
            $(`.role-option[data-role="${role}"]`).addClass('active');

            // Fill form
            $('input[name="Username"]').val(usernames[role]);
            $('input[name="Password"]').val('demo123');

            console.log('Demo login set for:', role); // Debug log

            Swal.fire({
                icon: 'success',
                title: 'ตั้งค่าบัญชีทดสอบ',
                text: `ตั้งค่าบัญชีทดสอบ ${role} เรียบร้อยแล้ว`,
                timer: 1500,
                showConfirmButton: false
            });
        }

        // Show welcome message based on time
        function showWelcomeMessage() {
            const hour = new Date().getHours();
            let greeting;

            if (hour < 12) {
                greeting = 'สวัสดีตอนเช้า';
            } else if (hour < 18) {
                greeting = 'สวัสดีตอนบ่าย';
            } else {
                greeting = 'สวัสดีตอนเย็น';
            }

            $('.brand-subtitle').text(`${greeting}! ยินดีต้อนรับสู่ระบบจัดการ NCR`);
        }

        showWelcomeMessage();
    </script>

    <style>
        .password-toggle {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #6c757d;
            z-index: 10;
        }

        .input-group {
            position: relative;
        }

        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }

        .input-group-text {
            background: #f8f9fa;
            border-color: #e9ecef;
        }

        .role-option input[type="radio"] {
            display: none;
        }
    </style>
</body>
</html>