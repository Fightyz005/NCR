@model NCRManagementSystem.Models.ViewModels.PrPriceRequestCreateViewModel

@{
    ViewData["Title"] = "สร้างใบขอราคาจาก PR";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">สร้างใบขอราคาจาก PR</h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> กลับ
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">ข้อมูลใบขอราคา</h6>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data" id="createForm">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label asp-for="PrNumber" class="control-label"></label>
                        <div class="input-group">
                            <input asp-for="PrNumber" class="form-control" placeholder="ระบุเลข PR (เช่น 1700002814)" />
                            <div class="input-group-append">
                                <button type="button" class="btn btn-primary" id="btnFetchPr">
                                    <i class="fas fa-search"></i> ดึงข้อมูล
                                </button>
                            </div>
                        </div>
                        <span asp-validation-for="PrNumber" class="text-danger"></span>
                    </div>
                     <div class="form-group col-md-6">
                        <label asp-for="VendorEmail" class="control-label"></label>
                        <input asp-for="VendorEmail" class="form-control" placeholder="vendor@example.com" />
                        <span asp-validation-for="VendorEmail" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Remarks" class="control-label"></label>
                    <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Remarks" class="text-danger"></span>
                </div>

                <hr />

                <h5 class="mb-3">รายการจาก PR</h5>

                <div class="table-responsive">
                    <table class="table table-bordered" id="itemsTable">
                        <thead>
                            <tr>
                                <th style="width: 10%">Plant</th>
                                <th style="width: 15%">รหัสวัตถุดิบ</th>
                                <th style="width: 25%">ชื่อวัตถุดิบ</th>
                                <th style="width: 10%">จำนวน</th>
                                <th style="width: 10%">หน่วย</th>
                                <th style="width: 20%">หมายเหตุ</th>
                                <th style="width: 5%">ลบ</th>
                            </tr>
                        </thead>
                        <tbody id="itemsContainer">
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <tr class="item-row" data-index="@i">
                                    <td>
                                        <input asp-for="Items[i].Plant" class="form-control form-control-sm" readonly />
                                    </td>
                                    <td>
                                        <input asp-for="Items[i].MaterialCode" class="form-control form-control-sm" readonly />
                                    </td>
                                    <td>
                                        <input asp-for="Items[i].MaterialName" class="form-control form-control-sm" readonly />
                                    </td>
                                    <td>
                                        <input asp-for="Items[i].Quantity" class="form-control form-control-sm" readonly />
                                    </td>
                                    <td>
                                        <input asp-for="Items[i].Unit" class="form-control form-control-sm" readonly />
                                    </td>
                                    <td>
                                        <input asp-for="Items[i].Remark" class="form-control form-control-sm" />
                                        <div class="mt-1">
                                            <input asp-for="Items[i].Files" type="file" multiple class="form-control-file" />
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-danger btn-sm remove-item">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="form-group text-right mt-4">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fas fa-save"></i> บันทึกข้อมูล
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            let itemIndex = @Model.Items.Count;

            // Fetch PR Logic
            $('#btnFetchPr').click(function() {
                var banfn = $('#PrNumber').val();
                if (!banfn) {
                    alert('กรุณาระบุเลขที่ PR');
                    return;
                }

                // Show loading
                var btn = $(this);
                var originalText = btn.html();
                btn.html('<i class="fas fa-spinner fa-spin"></i> กำลังโหลด...');
                btn.prop('disabled', true);

                $.get('@Url.Action("FetchPrItems", "PrPriceRequest")', { banfn: banfn })
                    .done(function(data) {
                        if (data && data.length > 0) {
                            // Clear existing items
                            $('#itemsContainer').empty();
                            itemIndex = 0;

                            data.forEach(function(item) {
                                addItemRow(item);
                            });
                        } else {
                            alert('ไม่พบข้อมูล PR หรือไม่มีรายการ');
                        }
                    })
                    .fail(function(xhr) {
                        alert('เกิดข้อผิดพลาด: ' + (xhr.responseText || 'ไม่สามารถดึงข้อมูลได้'));
                    })
                    .always(function() {
                        btn.html(originalText);
                        btn.prop('disabled', false);
                    });
            });

            // Remove Item Logic
            $(document).on('click', '.remove-item', function() {
                if (confirm('ต้องการลบรายการนี้ใช่หรือไม่?')) {
                    $(this).closest('tr').remove();
                    reindexItems();
                }
            });
            
            // Helper to add row
            function addItemRow(data) {
                var html = `
                    <tr class="item-row" data-index="${itemIndex}">
                        <td>
                            <input name="Items[${itemIndex}].Plant" value="${data.werks}" class="form-control form-control-sm" readonly />
                        </td>
                        <td>
                            <input name="Items[${itemIndex}].MaterialCode" value="${data.matnr}" class="form-control form-control-sm" readonly />
                        </td>
                        <td>
                            <input name="Items[${itemIndex}].MaterialName" value="${data.txz01}" class="form-control form-control-sm" readonly />
                        </td>
                        <td>
                            <input name="Items[${itemIndex}].Quantity" value="${data.menge}" class="form-control form-control-sm" readonly />
                        </td>
                        <td>
                            <input name="Items[${itemIndex}].Unit" value="${data.meins}" class="form-control form-control-sm" readonly />
                        </td>
                        <td>
                            <input name="Items[${itemIndex}].Remark" class="form-control form-control-sm" />
                            <div class="mt-1">
                                <input name="Items[${itemIndex}].Files" type="file" multiple class="form-control-file" />
                            </div>
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-danger btn-sm remove-item">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                `;
                
                $('#itemsContainer').append(html);
                itemIndex++;
            }

            function reindexItems() {
                $('#itemsContainer tr').each(function(index) {
                    $(this).attr('data-index', index);
                    $(this).find('input').each(function() {
                        var name = $(this).attr('name');
                        if (name) {
                            $(this).attr('name', name.replace(/Items\[\d+\]/, 'Items[' + index + ']'));
                        }
                    });
                });
                itemIndex = $('#itemsContainer tr').length;
            }
        });
    </script>
}
