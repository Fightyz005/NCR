@* Views/MaterialPriceRequest/UpdatePrice.cshtml *@
@model NCRManagementSystem.Models.ViewModels.MaterialPriceUpdateViewModel
@{
    ViewData["Title"] = $"อัพเดตราคา {Model.Request.RequestNumber}";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">อัพเดตราคา - @Model.Request.RequestNumber</h5>
        <span class="badge @Model.Request.StatusBadgeClass">@Model.Request.StatusDisplay</span>
    </div>
    <div class="card-body">
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            ผู้ร้องขอ: <strong>@Model.Request.RequestByName</strong> |
            วันที่ร้องขอ: <strong>@Model.Request.RequestDate.ToString("dd/MM/yyyy HH:mm")</strong>
        </div>

        <form asp-action="UpdatePrice" method="post" id="updatePriceForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Request.RequestId" value="@Model.Request.RequestId" />

            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th width="5%">#</th>
                            <th width="10%">รหัส</th>
                            <th width="15%">ชื่อวัตถุดิบ</th>
                            <th width="10%">รูปภาพ</th>
                            <th width="12%">ราคา/หน่วย</th>
                            <th width="8%">สกุลเงิน</th>
                            <th width="15%">Supplier</th>
                            <th width="8%">Lead Time</th>
                            <th width="12%">หมายเหตุ</th>
                            <th width="5%">สถานะ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Items.Count; i++)
                        {
                            var item = Model.Items[i];
                            <tr class="@(item.Status == "Pending" ? "" : "table-success")">
                                <td>
                                    @(i + 1)
                                    <input type="hidden" name="Items[@i].ItemId" value="@item.ItemId" />
                                    <input type="hidden" name="Items[@i].MaterialCode" value="@item.MaterialCode" />
                                    <input type="hidden" name="Items[@i].MaterialName" value="@item.MaterialName" />
                                    <input type="hidden" name="Items[@i].Status" value="@item.Status" />
                                </td>
                                <td>
                                    <strong>@item.MaterialCode</strong>
                                </td>
                                <td>
                                    @item.MaterialName
                                    @if (!string.IsNullOrEmpty(item.Remark))
                                    {
                                        <br>
                                
                                        <small class="text-muted">@item.Remark</small>
                                    }
                                </td>
                                <td>
                                    @if (item.Files.Any())
                                    {
                                        @foreach (var file in item.Files)
                                        {
                                            if (file.IsImage)
                                            {
                                                <a href="@Url.Action("DownloadFile", new { fileId = file.FileId })" target="_blank">
                                                    <img src="@Url.Action("DownloadFile", new { fileId = file.FileId })"
                                                         class="img-thumbnail" style="max-width: 60px; max-height: 60px;">
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="@Url.Action("DownloadFile", new { fileId = file.FileId })"
                                                   class="badge bg-secondary" target="_blank">
                                                    <i class="fas fa-file"></i>
                                                </a>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <input name="Items[@i].UnitPrice" type="number" step="0.01" min="0"
                                           class="form-control form-control-sm"
                                           value="@item.UnitPrice" placeholder="0.00">
                                </td>
                                <td>
                                    <select name="Items[@i].Currency" class="form-select form-select-sm">
                                        @foreach (var currency in Model.CurrencyOptions)
                                        {
                                            <option value="@currency.Value" selected="@(item.Currency == currency.Value)">
                                                @currency.Value
                                            </option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input name="Items[@i].SupplierName" class="form-control form-control-sm"
                                           value="@item.SupplierName" placeholder="ชื่อ Supplier">
                                </td>
                                <td>
                                    <input name="Items[@i].LeadTimeDays" type="number" min="0"
                                           class="form-control form-control-sm"
                                           value="@item.LeadTimeDays" placeholder="วัน">
                                </td>
                                <td>
                                    <input name="Items[@i].PriceRemark" class="form-control form-control-sm"
                                           value="@item.PriceRemark" placeholder="หมายเหตุ">
                                </td>
                                <td class="text-center">
                                    @if (item.Status == "Priced")
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-check"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">
                                            <i class="fas fa-clock"></i>
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i>บันทึกราคา
                </button>
                <button type="button" class="btn btn-success" onclick="saveAndComplete()">
                    <i class="fas fa-check me-2"></i>บันทึกและปิดงาน
                </button>
                <a href="@Url.Action("Details", new { id = Model.Request.RequestId })" class="btn btn-outline-secondary">
                    <i class="fas fa-times me-2"></i>ยกเลิก
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function saveAndComplete() {
            Swal.fire({
                title: 'บันทึกและปิดงาน',
                text: 'ต้องการบันทึกราคาและปิดงานใบร้องขอนี้หรือไม่?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'บันทึกและปิดงาน',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Submit form first
                    const form = document.getElementById('updatePriceForm');
                    const formData = new FormData(form);

                    fetch(form.action, {
                        method: 'POST',
                        body: formData
                    }).then(response => {
                        // Then complete
                        NCRSystem.ajaxPost('@Url.Action("Complete", new { id = Model.Request.RequestId })', {}, function() {
                            window.location.href = '@Url.Action("Details", new { id = Model.Request.RequestId })';
                        });
                    });
                }
            });
        }
    </script>
}